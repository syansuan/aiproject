# 依赖和构建产物
node_modules/
dist/
build/
.vite/
.cache/

# 环境变量 —— 绝对不要提交！
# 这里放的是 API Key，泄露出去会被人刷爆账户
.env
.env.local
.env.*.local

# 浏览器端的本地配置 —— 由 npm run config 从 .env 自动生成，含真实 Key，绝不提交
# 别手动创建这个文件：只改 .env，然后跑一次 npm run config
config.local.js

# 学习用的参考实现 —— 相当于自己的答案本，不进公开仓库
# 面试官看到「app.js + app.参考实现.js」会怀疑哪个是你写的
app.参考实现.js
*参考实现*

# 个人安排 / 学习计划 —— 含个人作息、辅导批注等，不进公开仓库
PLAN.local.md
*.local.md

# 编辑器和系统文件
# 只放行这两份「给别人看的」编辑配置：插件推荐 + 存盘自动格式化
# 其余 .vscode/* 是个人的，不进仓库
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 临时文件
*.tmp
*.temp
.tmp/
